rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // True only when an update touches nothing beyond the listed fields.
    // Used so anyone can bump shared counters (likes/views/downloads) without
    // being able to rewrite the rest of a document they don't own.
    function onlyFields(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // True when the signed-in user is one of the two people in a match. Used to
    // keep matrimony DMs private to their participants.
    function isMatchParticipant(matchId) {
      let m = get(/databases/$(database)/documents/matrimonyMatches/$(matchId)).data;
      return request.auth != null
        && (m.user1Id == request.auth.uid || m.user2Id == request.auth.uid);
    }

    // Users collection - users can read/write their own document
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
      // Allow creating user profile on first login
      allow create: if request.auth != null && request.auth.uid == userId;
    }

    // Username reservations - written only by the server (Admin SDK).
    // Public read is allowed so the signup form can check availability.
    match /usernames/{username} {
      allow read: if true;
      allow write: if false;
    }

    // SAP ID reservations - fully locked; only the server (Admin SDK) touches these.
    match /sapIds/{sapId} {
      allow read: if false;
      allow write: if false;
    }

    // Email verification OTP codes - fully locked; only the server (Admin SDK)
    // reads/writes these. Codes are stored hashed and expire quickly.
    match /emailVerifications/{uid} {
      allow read: if false;
      allow write: if false;
    }

    // Pending (pre-verification) registrations - fully locked; only the server
    // (Admin SDK) touches these. Holds profile data + a hashed OTP until the
    // account is created on successful verification.
    match /pendingRegistrations/{email} {
      allow read: if false;
      allow write: if false;
    }
    
    // Users can read/write their own Google Calendar tokens
    match /googleCalendarTokens/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Schedules - users can read/write their own schedules
    match /schedules/{scheduleId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Assignments - users can read/write their own assignments
    match /assignments/{assignmentId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Courses - users can read/write their own courses
    match /courses/{courseId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Assignment Submissions - users can read/write their own submissions
    match /assignmentSubmissions/{submissionId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Assignment Reminders - users can read/write their own reminders
    match /assignmentReminders/{reminderId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Reminder Preferences - users can read/write their own preferences
    match /reminderPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Assignment Health Scores - users can read/write their own scores
    match /assignmentHealthScores/{scoreId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Microsoft OAuth Tokens - users can read/write their own tokens
    match /microsoftTokens/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Notes - all authenticated users can read; only the uploader can edit/delete.
    // Anyone may bump the view/download counters.
    match /notes/{noteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uploaderId == request.auth.uid;
      allow update: if request.auth != null && (
        (resource.data.uploaderId == request.auth.uid
          && request.resource.data.uploaderId == resource.data.uploaderId)
        || onlyFields(['views', 'downloads', 'totalRatings', 'averageRating', 'updatedAt'])
      );
      allow delete: if request.auth != null && resource.data.uploaderId == request.auth.uid;
    }
    
    // Note ratings - users can read all, write only their own rating doc
    match /noteRatings/{ratingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }
    
    // Exam Survival Kits - authenticated users can read/create; only the
    // download counter can be updated by others; deletion via Admin SDK only.
    match /examSurvivalKits/{kitId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && onlyFields(['downloads', 'updatedAt']);
      allow delete: if false;
    }
    
    // PYQs - authenticated users can read/create; only the download counter can
    // be bumped; deletion/moderation happens via the Admin SDK.
    match /pyqs/{pyqId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && onlyFields(['downloadCount', 'updatedAt']);
      allow delete: if false;
    }
    
    // Events - public read; authenticated users can create. Edits/deletes are
    // limited to the creator (falls back to Admin SDK for older docs).
    match /events/{eventId} {
      allow read: if true; // Public read
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;
    }
    
    // Campus Voices — anonymous student posts. Anyone can bump like/report
    // counters; only the author can edit the post body or delete it.
    match /campusVoices/{voiceId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.authorId == request.auth.uid
        || onlyFields(['likes', 'reports', 'updatedAt'])
      );
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    match /campusVoiceLikes/{likeId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /campusVoiceReports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Legacy confession collections (deprecated, kept read-only)
    match /confessions/{confessionId} {
      allow read: if true;
      allow write: if false;
    }
    match /confessionLikes/{likeId} {
      allow read: if true;
      allow write: if false;
    }
    match /confessionReports/{reportId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Allow authenticated users to read/write rooms
    match /rooms/{roomId} {
      allow read: if true; // Public read
      allow write: if request.auth != null;
    }
    
    // Matrimony profiles - only signed-in users can browse profiles (they hold
    // personal data), and you can only write your own.
    match /matrimonyProfiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Matrimony matches - users can read their own matches
    match /matrimonyMatches/{matchId} {
      allow read: if request.auth != null && (
        resource.data.user1Id == request.auth.uid ||
        resource.data.user2Id == request.auth.uid
      );
      allow write: if request.auth != null && (
        resource.data.user1Id == request.auth.uid ||
        resource.data.user2Id == request.auth.uid
      );
    }
    
    // Matrimony chats - only the two people in the match can read the thread,
    // and you can only send messages as yourself. Messages are immutable.
    match /matrimonyChats/{messageId} {
      allow read: if request.auth != null && isMatchParticipant(resource.data.matchId);
      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid
        && isMatchParticipant(request.resource.data.matchId);
      allow update, delete: if false;
    }
    
    // Matrimony reports - a user can file a report as themselves; reads are
    // reserved for moderation via the Admin SDK.
    match /matrimonyReports/{reportId} {
      allow read: if false;
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if false;
    }
    
    // Results - users can read/write their own results
    match /results/{resultId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Canteen Orders - readable by the owner only. All writes go through the
    // server (Admin SDK), which sets status/paymentVerified ONLY after a valid
    // Razorpay signature. Blocking client writes stops a user from marking
    // their own order "completed" without actually paying.
    match /canteenOrders/{orderId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Beta feedback — authenticated users can submit; only admins read via Firebase Console
    match /betaFeedback/{feedbackId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.category in ['bug', 'feature', 'confusing', 'general', 'praise']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 2000
        && request.resource.data.pagePath is string
        && request.resource.data.createdAt is timestamp
        && (!('username' in request.resource.data) || request.resource.data.username is string)
        && (!('userAgent' in request.resource.data) || request.resource.data.userAgent is string);
      allow read, update, delete: if false;
    }
  }
}
