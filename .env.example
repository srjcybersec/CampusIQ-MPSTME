# ─────────────────────────────────────────────────────────────
#  CampusIQ · environment variables
#  Copy to .env.local and fill in. Never commit real values.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase (client): Project settings → General → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server): Project settings → Service accounts
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Gemini: https://aistudio.google.com/
NEXT_PUBLIC_GEMINI_API_KEY=

# Google Calendar OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Microsoft Graph, for Teams assignment sync (optional)
MICROSOFT_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# Razorpay, for canteen payments (optional, use rzp_test_ keys locally)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Brevo, for OTP signup emails
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=CampusIQ

# Secrets: generate each with `openssl rand -hex 32`
OTP_SECRET=
CRON_SECRET=
ADMIN_PURGE_SECRET=

# Examination policy text used by the policy chat (optional)
NEXT_PUBLIC_EXAMINATION_POLICY=
